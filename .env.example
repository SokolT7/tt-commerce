# ============================================================================
# Gate Delivery — environment
#
# Copy to .env.local and fill in. Never commit .env.local.
# Values marked REQUIRED must be set before the app will start.
# ============================================================================

# --- Supabase -------------------------------------------------------- REQUIRED
# Project settings → API. The anon key is safe in the browser; the service role
# key is not, and is only ever read on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Application ----------------------------------------------------- REQUIRED
# Public base URL. Used to build the QR codes printed on seats.
NEXT_PUBLIC_APP_URL=

# --- Payments ------------------------------------------------- not yet needed
# Leave blank to run with the mock payment provider. When these are set the
# app switches to real payment authorisation.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Croatian fiscalisation ----------------------------------- not yet needed
# Real-time receipts and EN 16931 e-invoices through a certified provider.
# Blank means fiscal documents are recorded but marked simulated.
FISCAL_PROVIDER_URL=
FISCAL_PROVIDER_API_KEY=
FISCAL_BUSINESS_OIB=
FISCAL_PREMISE_CODE=
FISCAL_DEVICE_CODE=

# --- Robot fleet ---------------------------------------------- not yet needed
# 'simulated' (the default) completes the legs a robot would drive instantly:
# marking an order ready puts a unit at the counter, and loading it puts the
# unit at the passenger. Order states, compartments and missions are all real
# — only the travel is skipped, so the whole flow is testable without hardware.
#
# Set to 'vendor' once the robot interface exists, so the simulation cannot
# quietly stay on underneath real hardware.
FLEET_ADAPTER=simulated
ROBOT_API_BASE_URL=
ROBOT_API_KEY=
ROBOT_FLEET_ID=

# --- Live flight information ---------------------------------- not yet needed
# Cirium / FlightStats FIDS API. Credentials come from the Applications page
# at developer.flightstats.com — each application has its own pair.
# Blank means the seeded flight board is used instead.
FLIGHTSTATS_APP_ID=
FLIGHTSTATS_APP_KEY=

# IATA code of the airport to pull departures for. ZAG is Franjo Tuđman.
FIDS_AIRPORT=ZAG

# How far ahead to pull, in hours. The API caps this per request.
FIDS_HOURS=6

# FIDS publishes departure times, not boarding times. Boarding is derived by
# subtracting this many minutes from the scheduled gate departure.
FIDS_BOARDING_LEAD_MINUTES=35

# Optional shared secret so the sync endpoint can be called by a scheduler
# as well as from the dashboard. Blank disables unauthenticated cron access.
FIDS_SYNC_SECRET=
